new file mode 100644
index 0000000000000000000000000000000000000000..a308087d352a2823b624bc0e4c9e1059d6561c7f
--- /dev/null
+++ b/tunnel/business.go
@@ -0,0 +1,64 @@
+package tunnel
+
+import (
+	"context"
+	"net"
+
+	"github.com/metacubex/mihomo/component/requestscope"
+	C "github.com/metacubex/mihomo/constant"
+	icontext "github.com/metacubex/mihomo/context"
+)
+
+type businessTunnel struct{ scope *requestscope.BusinessScope }
+
+func BindBusiness(scope *requestscope.BusinessScope) C.Tunnel { return businessTunnel{scope} }
+func (t businessTunnel) NatTable() C.NatTable                 { return natTable }
+func (t businessTunnel) TrackInbound(conn net.Conn) (net.Conn, error) {
+	if err := t.scope.Check(); err != nil {
+		_ = conn.Close()
+		return nil, err
+	}
+	guarded := t.scope.GuardConn(conn)
+	if err := t.scope.Check(); err != nil {
+		_ = guarded.Close()
+		return nil, err
+	}
+	return guarded, nil
+}
+func (t businessTunnel) HandleTCPConn(conn net.Conn, metadata *C.Metadata) {
+	handleTCPConnScoped(icontext.NewConnContext(conn, metadata), t.scope.Context(), t.scope)
+}
+func (t businessTunnel) HandleUDPPacket(packet C.UDPPacket, metadata *C.Metadata) {
+	enqueueUDPPacket(packet, metadata, t.scope)
+}
+
+type businessPacket struct {
+	C.PacketAdapter
+	scope *requestscope.BusinessScope
+}
+
+func (p *businessPacket) Key() string { return p.scope.Key(p.PacketAdapter.Key()) }
+func (p *businessPacket) WriteBack(data []byte, addr net.Addr) (int, error) {
+	if err := p.scope.Check(); err != nil {
+		return 0, err
+	}
+	return p.PacketAdapter.WriteBack(data, addr)
+}
+func packetBusiness(packet C.PacketAdapter) *requestscope.BusinessScope {
+	if scoped, ok := packet.(*businessPacket); ok {
+		return scoped.scope
+	}
+	return nil
+}
+func businessContext(scope *requestscope.BusinessScope) context.Context {
+	if scope != nil {
+		return scope.Context()
+	}
+	return context.Background()
+}
+func businessCheck(scope *requestscope.BusinessScope) error {
+	if scope != nil {
+		return scope.Check()
+	}
+	return nil
+}
diff --git a/tunnel/business_test.go b/tunnel/business_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..aae096046a5182cb606d1f1b8f8e20048cb89231
--- /dev/null
+++ b/tunnel/business_test.go
@@ -0,0 +1,181 @@
+package tunnel
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/metacubex/mihomo/component/requestscope"
+	C "github.com/metacubex/mihomo/constant"
+	RC "github.com/metacubex/mihomo/rules/common"
+)
+
+type businessRuleBarrier struct {
+	C.Rule
+	entered, release chan struct{}
+	once             sync.Once
+}
+
+func (r *businessRuleBarrier) Match(metadata *C.Metadata, helper C.RuleMatchHelper) (bool, string) {
+	r.once.Do(func() { close(r.entered) })
+	<-r.release
+	return r.Rule.Match(metadata, helper)
+}
+
+type businessDialCounter struct {
+	C.Proxy
+	dials atomic.Int32
+}
+
+func (p *businessDialCounter) SupportUDP() bool { return true }
+
+func (p *businessDialCounter) Name() string                     { return "DIRECT" }
+func (p *businessDialCounter) Type() C.AdapterType              { return C.Direct }
+func (p *businessDialCounter) Unwrap(*C.Metadata, bool) C.Proxy { return nil }
+
+func (p *businessDialCounter) DialContext(context.Context, *C.Metadata) (C.Conn, error) {
+	p.dials.Add(1)
+	return nil, errors.New("unexpected business dial")
+}
+func (p *businessDialCounter) ListenPacketContext(context.Context, *C.Metadata) (C.PacketConn, error) {
+	p.dials.Add(1)
+	return nil, errors.New("unexpected business packet dial")
+}
+
+type businessTestPacket struct {
+	dropped chan struct{}
+	once    sync.Once
+}
+
+func (p *businessTestPacket) Data() []byte { return []byte("old packet") }
+func (p *businessTestPacket) LocalAddr() net.Addr {
+	return &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 49317}
+}
+func (p *businessTestPacket) WriteBack([]byte, net.Addr) (int, error) {
+	return 0, errors.New("unexpected old response")
+}
+func (p *businessTestPacket) Drop() { p.once.Do(func() { close(p.dropped) }) }
+
+func TestBusinessRevokedDuringRuleResolution(t *testing.T) {
+	for _, network := range []C.NetWork{C.TCP, C.UDP} {
+		t.Run(network.String(), func(t *testing.T) {
+			barrier := &businessRuleBarrier{Rule: RC.NewMatch("DIRECT"), entered: make(chan struct{}), release: make(chan struct{})}
+			proxy := &businessDialCounter{}
+			configMux.Lock()
+			oldRules, oldProxies, oldMode := rules, proxies, mode
+			rules, proxies, mode = []C.Rule{barrier}, map[string]C.Proxy{"DIRECT": proxy}, Rule
+			configMux.Unlock()
+			defer func() { configMux.Lock(); rules, proxies, mode = oldRules, oldProxies, oldMode; configMux.Unlock() }()
+			scope := requestscope.NewBusinessScope(17, func() bool { return true })
+			scope.Activate()
+			defer scope.Close()
+			metadata := &C.Metadata{NetWork: network, Type: C.SOCKS5, SrcIP: netip.MustParseAddr("127.0.0.1"), SrcPort: 49317, DstIP: netip.MustParseAddr("127.0.0.1"), DstPort: 49318}
+			done := make(chan struct{})
+			if network == C.TCP {
+				client, server := net.Pipe()
+				defer client.Close()
+				go func() { businessTunnel{scope}.HandleTCPConn(server, metadata); close(done) }()
+			} else {
+				packet := &businessTestPacket{dropped: done}
+				businessTunnel{scope}.HandleUDPPacket(packet, metadata)
+			}
+			select {
+			case <-barrier.entered:
+			case <-time.After(3 * time.Second):
+				t.Fatal("real rule resolution did not reach barrier")
+			}
+			scope.Close()
+			close(barrier.release)
+			select {
+			case <-done:
+			case <-time.After(3 * time.Second):
+				t.Fatal("revoked business work did not finish")
+			}
+			if proxy.dials.Load() != 0 {
+				t.Fatal("revoked resolution started a network action")
+			}
+		})
+	}
+}
+
+func TestBusinessPacketKeepsOriginalActivation(t *testing.T) {
+	old := requestscope.NewBusinessScope(1, func() bool { return true })
+	old.Activate()
+	current := requestscope.NewBusinessScope(2, func() bool { return true })
+	current.Activate()
+	defer current.Close()
+	packet := &businessTestPacket{dropped: make(chan struct{})}
+	metadata := &C.Metadata{}
+	oldPacket := &businessPacket{PacketAdapter: C.NewPacketAdapter(packet, metadata), scope: old}
+	newPacket := &businessPacket{PacketAdapter: C.NewPacketAdapter(packet, metadata), scope: current}
+	if oldPacket.Key() == newPacket.Key() {
+		t.Fatal("UDP activations share a NAT namespace")
+	}
+	old.Close()
+	if _, err := oldPacket.WriteBack([]byte("late"), nil); err == nil {
+		t.Fatal("old response borrowed a new activation")
+	}
+	if businessCheck(current) != nil {
+		t.Fatal("retiring old UDP also retired the new scope")
+	}
+}
+
+type businessSenderBarrier struct {
+	C.PacketConn
+	entered, release chan struct{}
+	writes           atomic.Int32
+}
+
+func (pc *businessSenderBarrier) ResolveUDP(_ context.Context, metadata *C.Metadata) error {
+	close(pc.entered)
+	<-pc.release
+	metadata.DstIP = netip.MustParseAddr("127.0.0.1")
+	return nil
+}
+func (pc *businessSenderBarrier) WriteTo(data []byte, _ net.Addr) (int, error) {
+	pc.writes.Add(1)
+	return len(data), nil
+}
+
+func TestBusinessSenderRevocationDropsResolvingAndQueuedPackets(t *testing.T) {
+	scope := requestscope.NewBusinessScope(31, func() bool { return true })
+	scope.Activate()
+	defer scope.Close()
+	sender := newPacketSenderScoped(scope)
+	defer sender.Close()
+	pc := &businessSenderBarrier{entered: make(chan struct{}), release: make(chan struct{})}
+	first := &businessTestPacket{dropped: make(chan struct{})}
+	queued := &businessTestPacket{dropped: make(chan struct{})}
+	metadata := &C.Metadata{NetWork: C.UDP, Type: C.SOCKS5, Host: "local.test", DstPort: 53}
+	sender.Send(&businessPacket{PacketAdapter: C.NewPacketAdapter(first, metadata), scope: scope})
+	done := make(chan struct{})
+	go func() { sender.Process(pc, nil); close(done) }()
+	select {
+	case <-pc.entered:
+	case <-time.After(time.Second):
+		t.Fatal("sender did not resolve")
+	}
+	sender.Send(&businessPacket{PacketAdapter: C.NewPacketAdapter(queued, metadata.Clone()), scope: scope})
+	scope.Close()
+	close(pc.release)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("sender did not finish after revoke")
+	}
+	for _, packet := range []*businessTestPacket{first, queued} {
+		select {
+		case <-packet.dropped:
+		default:
+			t.Fatal("old sender retained packet")
+		}
+	}
+	if pc.writes.Load() != 0 {
+		t.Fatal("old sender wrote after resolving revoke")
+	}
+}
