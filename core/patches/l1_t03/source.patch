new file mode 100644
index 0000000000000000000000000000000000000000..e3f3fe29e54482bac176093c8dc820861f524950
--- /dev/null
+++ b/component/requestscope/business.go
@@ -0,0 +1,127 @@
+package requestscope
+
+import (
+	"context"
+	"net"
+	"strconv"
+	"sync"
+	"sync/atomic"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/sing/common"
+)
+
+var BusinessHook func() *BusinessScope
+
+// BusinessScope belongs to one activation. Its check uses the host's existing
+// Owner and service authority; it grants no application data commit rights.
+type BusinessScope struct {
+	ID      uint64
+	ctx     context.Context
+	cancel  context.CancelFunc
+	active  atomic.Bool
+	retired atomic.Bool
+	check   func() bool
+}
+
+func NewBusinessScope(id uint64, check func() bool) *BusinessScope {
+	ctx, cancel := context.WithCancel(context.Background())
+	return &BusinessScope{ID: id, ctx: ctx, cancel: cancel, check: check}
+}
+
+func (s *BusinessScope) Context() context.Context { return s.ctx }
+func (s *BusinessScope) IsActive() bool           { return s.active.Load() && !s.retired.Load() }
+func (s *BusinessScope) Dialer() C.Dialer         { return nil }
+func (s *BusinessScope) Activate() bool {
+	if s.retired.Load() {
+		return false
+	}
+	s.active.Store(true)
+	return !s.retired.Load()
+}
+func (s *BusinessScope) Invalidate() func() {
+	s.retired.Store(true)
+	return s.cancel
+}
+func (s *BusinessScope) Close() { s.Invalidate()() }
+func (s *BusinessScope) Check() error {
+	if s.retired.Load() || !s.active.Load() || s.ctx.Err() != nil || s.check != nil && !s.check() {
+		return ErrBlocked
+	}
+	return nil
+}
+func (s *BusinessScope) TrackConn(conn net.Conn) error {
+	if err := s.Check(); err != nil {
+		_ = conn.Close()
+		return err
+	}
+	context.AfterFunc(s.ctx, func() { _ = conn.Close() })
+	if err := s.Check(); err != nil {
+		_ = conn.Close()
+		return err
+	}
+	return nil
+}
+func (s *BusinessScope) LockCommit(context.Context) (func(), error) { return nil, ErrBlocked }
+func (s *BusinessScope) GrantCommit() (Receipt, error)              { return nil, ErrBlocked }
+func (s *BusinessScope) Key(key string) string                      { return strconv.FormatUint(s.ID, 10) + ":" + key }
+
+// GuardConn keeps copy/unwrap fast paths behind the per-action check.
+func (s *BusinessScope) GuardConn(conn net.Conn) net.Conn {
+	c := &businessConn{Conn: conn, scope: s}
+	c.stop = context.AfterFunc(s.ctx, func() { _ = conn.Close() })
+	return c
+}
+
+type businessConn struct {
+	net.Conn
+	scope *BusinessScope
+	stop  func() bool
+	once  sync.Once
+}
+
+func (c *businessConn) Close() (err error) {
+	c.once.Do(func() {
+		if c.stop != nil {
+			c.stop()
+		}
+		err = c.Conn.Close()
+	})
+	return
+}
+
+func (c *businessConn) Read(p []byte) (int, error) {
+	if err := c.scope.Check(); err != nil {
+		return 0, err
+	}
+	n, err := c.Conn.Read(p)
+	if check := c.scope.Check(); check != nil {
+		return 0, check
+	}
+	return n, err
+}
+func (c *businessConn) Write(p []byte) (int, error) {
+	if err := c.scope.Check(); err != nil {
+		return 0, err
+	}
+	return c.Conn.Write(p)
+}
+
+func (c *businessConn) CloseWrite() error {
+	if err := c.scope.Check(); err != nil {
+		return err
+	}
+	if writer, ok := common.Cast[interface{ CloseWrite() error }](c.Conn); ok {
+		return writer.CloseWrite()
+	}
+	return c.Conn.Close()
+}
+
+func AcceptBusinessConn(tunnel C.Tunnel, conn net.Conn) (net.Conn, error) {
+	if scoped, ok := tunnel.(interface {
+		TrackInbound(net.Conn) (net.Conn, error)
+	}); ok {
+		return scoped.TrackInbound(conn)
+	}
+	return conn, nil
+}
