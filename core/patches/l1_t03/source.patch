+func TestRequestGeoInitialFailureKeepsPeriodicUpdater(t *testing.T) {
+	originalHome, originalURL := C.Path.HomeDir(), geodata.ASNUrl()
+	defer C.SetHomeDir(originalHome)
+	defer geodata.SetASNUrl(originalURL)
+	C.SetHomeDir(t.TempDir())
+	data, err := os.ReadFile("../../../../assets/data/ASN.mmdb")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(C.Path.ASN(), data, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err = geodata.InitASN(); err != nil {
+		t.Fatal(err)
+	}
+	_ = os.Chtimes(C.Path.ASN(), time.Unix(0, 0), time.Unix(0, 0))
+	done := make(chan struct{})
+	var requests atomic.Int32
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if requests.Add(1) == 1 {
+			w.WriteHeader(503)
+			return
+		}
+		_, _ = w.Write(data)
+	}))
+	defer server.Close()
+	geodata.SetASNUrl(server.URL)
+	prior := GeoUpdateHook
+	GeoUpdateHook = func(_ string, updating, skipped bool, err error) {
+		if !updating && err == nil {
+			select {
+			case <-done:
+			default:
+				close(done)
+			}
+		}
+	}
+	defer func() { GeoUpdateHook = prior }()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	stopped := registerGeoUpdaterPeriod(ctx, 10*time.Millisecond)
+	defer func() { cancel(); <-stopped }()
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("initial failure terminated the updater")
+	}
+	cancel()
+	<-stopped
+	if requests.Load() < 2 {
+		t.Fatal("periodic retry did not use the real HTTP consumer")
+	}
+}
