new file mode 100644
index 0000000000000000000000000000000000000000..5df9f351f05591a5d337b185d0dab73cce462bb3
--- /dev/null
+++ b/component/requestscope/scope.go
@@ -0,0 +1,277 @@
+package requestscope
+
+import (
+	"context"
+	"errors"
+	"net"
+	"sync"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+var (
+	ErrBlocked   = errors.New("application request blocked")
+	ErrCancelled = errors.New("application request cancelled")
+	ErrBootstrap = errors.New("application request needs bootstrap permission")
+)
+
+type Owner struct{ ID uint64 }
+
+type Spec struct {
+	Owner                                Owner
+	Kind, Trigger, Key, URL, Proxy, Mode string
+	Resource, Client, Permit             string
+	Dataset, SourceRevision, Operation   uint64
+	ExpectedState                        *StateVersion
+}
+
+type StateVersion struct {
+	Epoch    string
+	Revision uint64
+}
+
+type Completion struct {
+	Spec  Spec
+	State StateVersion
+}
+
+func CompletionOf(lease Lease) *Completion {
+	if captured, ok := lease.(interface{ CompletionVersion() Completion }); ok {
+		value := captured.CompletionVersion()
+		return &value
+	}
+	return nil
+}
+
+type Receipt interface {
+	Complete()
+	Fail(error)
+}
+
+type Lease interface {
+	Context() context.Context
+	Dialer() C.Dialer
+	Check() error
+	TrackConn(net.Conn) error
+	LockCommit(context.Context) (func(), error)
+	GrantCommit() (Receipt, error)
+	Close()
+}
+
+type ProxyBinding struct {
+	Lease Lease
+	User  string
+}
+
+type RoutingLease interface {
+	ProxyName() string
+	SelectProxy(C.Proxy, *C.Metadata) (C.Proxy, error)
+}
+
+func Route(lease Lease, metadata *C.Metadata) {
+	if routing, ok := lease.(RoutingLease); ok {
+		metadata.SpecialProxy = routing.ProxyName()
+	}
+}
+
+func SelectProxy(lease Lease, proxy C.Proxy, metadata *C.Metadata) (C.Proxy, error) {
+	if routing, ok := lease.(RoutingLease); ok {
+		return routing.SelectProxy(proxy, metadata)
+	}
+	return proxy, nil
+}
+
+func FixedProxy(lease Lease) (C.Proxy, bool) {
+	if routing, ok := lease.(interface{ FixedProxy() (C.Proxy, bool) }); ok {
+		return routing.FixedProxy()
+	}
+	return nil, false
+}
+
+var (
+	BeginHook       func(context.Context, Spec) (Lease, error)
+	ProxyHook       func(net.Conn, string, string) (ProxyBinding, bool, error)
+	PhaseHook       func(Owner, string)
+	OwnerHook       func() Owner
+	OwnerActiveHook func(Owner) bool
+	ReadyHook       func(context.Context, Owner, string) error
+	BootstrapHook   func(string, string, string) error
+	ResourceHook    func(context.Context, string) (func(), error)
+	ProxyUpdateHook func(Owner, func())
+)
+
+type contextKey struct{}
+
+func WithLease(ctx context.Context, lease Lease) context.Context {
+	return context.WithValue(ctx, contextKey{}, lease)
+}
+
+func FromContext(ctx context.Context) Lease {
+	lease, _ := ctx.Value(contextKey{}).(Lease)
+	return lease
+}
+
+func Begin(ctx context.Context, spec Spec) (Lease, error) {
+	if BeginHook == nil {
+		return nil, nil
+	}
+	return BeginHook(ctx, spec)
+}
+
+func Check(lease Lease) error {
+	if lease == nil {
+		return nil
+	}
+	return lease.Check()
+}
+
+func Commit(lease Lease, action func() error) error {
+	if lease == nil {
+		return action()
+	}
+	unlock, err := lease.LockCommit(lease.Context())
+	if err != nil {
+		return err
+	}
+	defer unlock()
+	receipt, err := lease.GrantCommit()
+	if err != nil {
+		return err
+	}
+	if err = action(); err != nil {
+		receipt.Fail(err)
+		return err
+	}
+	receipt.Complete()
+	return nil
+}
+
+func Phase(owner Owner, phase string) {
+	if PhaseHook != nil {
+		PhaseHook(owner, phase)
+	}
+}
+
+func CurrentOwner() Owner {
+	if OwnerHook == nil {
+		return Owner{}
+	}
+	return OwnerHook()
+}
+
+func WaitReady(ctx context.Context, owner Owner, proxies ...string) error {
+	if ReadyHook == nil {
+		return nil
+	}
+	proxy := ""
+	if len(proxies) > 0 {
+		proxy = proxies[0]
+	}
+	return ReadyHook(ctx, owner, proxy)
+}
+
+type AppTunnel interface {
+	HandleAppTCPConn(context.Context, net.Conn, *C.Metadata, Lease)
+}
+
+func HandleTCP(ctx context.Context, tunnel C.Tunnel, conn net.Conn, metadata *C.Metadata, lease Lease) {
+	if lease == nil {
+		tunnel.HandleTCPConn(conn, metadata)
+		return
+	}
+	scoped, ok := tunnel.(AppTunnel)
+	if !ok || lease.Check() != nil {
+		_ = conn.Close()
+		return
+	}
+	scoped.HandleAppTCPConn(ctx, conn, metadata, lease)
+}
+
+func BindProxy(conn net.Conn, user, password string) (ProxyBinding, bool, error) {
+	if ProxyHook == nil {
+		return ProxyBinding{}, false, nil
+	}
+	return ProxyHook(conn, user, password)
+}
+
+type trackedConn struct {
+	net.Conn
+	once sync.Once
+	stop func() bool
+}
+
+func Track(ctx context.Context, conn net.Conn, lease Lease) (net.Conn, error) {
+	if lease != nil {
+		if err := lease.TrackConn(conn); err != nil {
+			_ = conn.Close()
+			return nil, err
+		}
+	}
+	wrapped := &trackedConn{Conn: conn}
+	wrapped.stop = context.AfterFunc(ctx, func() { _ = conn.Close() })
+	if err := ctx.Err(); err != nil {
+		_ = wrapped.Close()
+		return nil, err
+	}
+	return wrapped, nil
+}
+
+func (c *trackedConn) Close() error {
+	var err error
+	c.once.Do(func() {
+		if c.stop != nil {
+			c.stop()
+		}
+		err = c.Conn.Close()
+	})
+	return err
+}
+
+func BeforeDial(lease Lease, metadata *C.Metadata) error {
+	if verifier, ok := lease.(interface{ BeforeDial(*C.Metadata) error }); ok {
+		return verifier.BeforeDial(metadata)
+	}
+	return Check(lease)
+}
+
+func NeedBootstrap(kind, url, path string) error {
+	if BootstrapHook != nil {
+		return BootstrapHook(kind, url, path)
+	}
+	return ErrBootstrap
+}
+
+func LockResource(ctx context.Context, key string) (func(), error) {
+	if ResourceHook != nil {
+		return ResourceHook(ctx, key)
+	}
+	return func() {}, nil
+}
+
+type ownerContextKey struct{}
+
+func WithOwner(ctx context.Context, owner Owner) context.Context {
+	return context.WithValue(ctx, ownerContextKey{}, owner)
+}
+func OwnerFromContext(ctx context.Context) Owner {
+	if owner, ok := ctx.Value(ownerContextKey{}).(Owner); ok {
+		return owner
+	}
+	return CurrentOwner()
+}
+
+func CheckTarget(lease Lease, url string) error {
+	if target, ok := lease.(interface{ CheckTarget(string) error }); ok {
+		return target.CheckTarget(url)
+	}
+	return Check(lease)
+}
+
+func CheckURL(lease Lease, target string) error {
+	if scoped, ok := lease.(interface{ CheckURL(string) error }); ok {
+		return scoped.CheckURL(target)
+	}
+	return Check(lease)
+}
+
+func OwnerActive(owner Owner) bool { return OwnerActiveHook == nil || OwnerActiveHook(owner) }
