diff --git a/adapter/provider/request_owner_test.go b/adapter/provider/request_owner_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..c28b1fff69e4ebe79db20f4a143604a013bf72a0
--- /dev/null
+++ b/adapter/provider/request_owner_test.go
@@ -0,0 +1,33 @@
+package provider
+
+import (
+	"context"
+	"testing"
+
+	"github.com/metacubex/mihomo/component/requestscope"
+)
+
+func TestRequestOwnerCapturedByProviderParser(t *testing.T) {
+	owner := requestscope.Owner{ID: 1}
+	oldOwner, oldBegin := requestscope.OwnerHook, requestscope.BeginHook
+	defer func() { requestscope.OwnerHook, requestscope.BeginHook = oldOwner, oldBegin }()
+	requestscope.OwnerHook = func() requestscope.Owner { return owner }
+	parser, err := NewProxiesParser("synthetic", nil, "", "", "", "", overrideSchema{}, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	owner = requestscope.Owner{ID: 2}
+	proxies, err := parser([]byte("proxies:\n  - name: old node\n    type: http\n    server: 127.0.0.1\n    port: 1\n"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	requestscope.BeginHook = func(_ context.Context, spec requestscope.Spec) (requestscope.Lease, error) {
+		if spec.Owner.ID != 1 {
+			t.Errorf("old parser borrowed new owner %v", spec.Owner)
+		}
+		return nil, requestscope.ErrCancelled
+	}
+	if _, err := proxies[0].URLTest(context.Background(), "http://127.0.0.1/", nil); err == nil {
+		t.Fatal("retired parser request was not rejected")
+	}
+}
