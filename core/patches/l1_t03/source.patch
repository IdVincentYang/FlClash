@@ -0,0 +1,42 @@
+package listener
+
+import (
+	"errors"
+	"sync/atomic"
+
+	C "github.com/metacubex/mihomo/constant"
+	"github.com/metacubex/mihomo/listener/mixed"
+	"github.com/metacubex/mihomo/listener/socks"
+)
+
+var bindingSequence atomic.Uint64
+
+type MixedBinding struct {
+	ID  uint64
+	tcp *mixed.Listener
+	udp *socks.UDPListener
+}
+
+func PrepareMixed(port int, tunnel C.Tunnel) (*MixedBinding, error) {
+	if port == 0 {
+		return nil, nil
+	}
+	if err := ReCreateMixedChecked(port, tunnel); err != nil {
+		return nil, err
+	}
+	mixedMux.Lock()
+	defer mixedMux.Unlock()
+	return &MixedBinding{ID: bindingSequence.Add(1), tcp: mixedListener, udp: mixedUDPLister}, nil
+}
+
+func (b *MixedBinding) Validate() error {
+	if b == nil {
+		return nil
+	}
+	mixedMux.Lock()
+	defer mixedMux.Unlock()
+	if b.tcp == nil || b.udp == nil || b.tcp != mixedListener || b.udp != mixedUDPLister || !b.tcp.Alive() || !b.udp.Alive() {
+		return errors.New("prepared mixed binding is no longer owned")
+	}
+	return nil
+}
